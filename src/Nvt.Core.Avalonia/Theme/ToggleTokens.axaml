<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:transforms="using:Avalonia.Media.Transformation">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedPointerOverBrush" ResourceKey="Nvt.Controls.SelectedPointerOverBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedPressedBrush" ResourceKey="Nvt.Controls.SelectedPressedBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedBrush" ResourceKey="Nvt.Controls.SelectedBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedForegroundBrush" ResourceKey="Nvt.Controls.SelectedForegroundBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPointerOverBrush" ResourceKey="Nvt.Interaction.HoverBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPressedBrush" ResourceKey="Nvt.Interaction.PressedBrush" />
      <StaticResource x:Key="Nvt.Toggle.RestBrush" ResourceKey="Nvt.Interaction.RestBrush" />
      <SolidColorBrush x:Key="Nvt.Toggle.SegmentRestBrush" Color="#00DCE5EF" />
      <StaticResource x:Key="Nvt.Toggle.SoftForegroundBrush" ResourceKey="NfcTextSecondaryBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPointerOverForegroundBrush" ResourceKey="NfcTextBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPressedForegroundBrush" ResourceKey="NfcTextStrongBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftDisabledForegroundBrush" ResourceKey="NfcTextDisabledBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftDisabledCheckedBrush" ResourceKey="NfcSelectionSurfaceBrush" />
      <StaticResource x:Key="Nvt.Toggle.SelectedBrush" ResourceKey="NfcAccentBrush" />
      <StaticResource x:Key="Nvt.Toggle.SelectedPointerOverBrush" ResourceKey="NfcAccentStrongBrush" />
      <SolidColorBrush x:Key="Nvt.Toggle.SelectedPressedBrush" Color="#0E3C9E" />
      <StaticResource x:Key="Nvt.Toggle.DangerFillBrush" ResourceKey="NfcDangerTextBrush" />
      <StaticResource x:Key="Nvt.Toggle.DangerFillPointerOverBrush" ResourceKey="NfcDangerTextStrongBrush" />
      <StaticResource x:Key="Nvt.Toggle.DangerFillPressedBrush" ResourceKey="NfcDangerTextStrongBrush" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchOnBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchPointerOverBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchPressedBrush" Color="#1E40AF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedPointerOverBrush" ResourceKey="Nvt.Controls.SelectedPointerOverBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedPressedBrush" ResourceKey="Nvt.Controls.SelectedPressedBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedBrush" ResourceKey="Nvt.Controls.SelectedBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftCheckedForegroundBrush" ResourceKey="Nvt.Controls.SelectedForegroundBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPointerOverBrush" ResourceKey="Nvt.Interaction.HoverBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPressedBrush" ResourceKey="Nvt.Interaction.PressedBrush" />
      <StaticResource x:Key="Nvt.Toggle.RestBrush" ResourceKey="Nvt.Interaction.RestBrush" />
      <SolidColorBrush x:Key="Nvt.Toggle.SegmentRestBrush" Color="#0026364D" />
      <StaticResource x:Key="Nvt.Toggle.SoftForegroundBrush" ResourceKey="NfcTextSecondaryBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPointerOverForegroundBrush" ResourceKey="NfcTextBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftPressedForegroundBrush" ResourceKey="NfcTextStrongBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftDisabledForegroundBrush" ResourceKey="NfcTextDisabledBrush" />
      <StaticResource x:Key="Nvt.Toggle.SoftDisabledCheckedBrush" ResourceKey="NfcSelectionSurfaceBrush" />
      <!-- Deep fills preserve white content contrast in the dark theme. -->
      <SolidColorBrush x:Key="Nvt.Toggle.SelectedBrush" Color="#1148BE" />
      <SolidColorBrush x:Key="Nvt.Toggle.SelectedPointerOverBrush" Color="#0E3C9E" />
      <SolidColorBrush x:Key="Nvt.Toggle.SelectedPressedBrush" Color="#0B307E" />
      <!-- A filled track or segment must keep 3:1 against the page and 4.5:1 against its white label or knob. In the dark theme that leaves a narrow window, so hover and pressed stay inside it. -->
      <SolidColorBrush x:Key="Nvt.Toggle.DangerFillBrush" Color="#CC3F54" />
      <SolidColorBrush x:Key="Nvt.Toggle.DangerFillPointerOverBrush" Color="#C8384D" />
      <SolidColorBrush x:Key="Nvt.Toggle.DangerFillPressedBrush" Color="#C8384D" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchOnBrush" Color="#2F6BEE" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchPointerOverBrush" Color="#2C68E8" />
      <SolidColorBrush x:Key="Nvt.Toggle.SwitchPressedBrush" Color="#2965E2" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <SolidColorBrush x:Key="Nvt.Toggle.SelectedLabelBrush" Color="#FFFFFF" />
  <StaticResource x:Key="Nvt.Toggle.KnobBrush" ResourceKey="Nvt.Toggle.SelectedLabelBrush" />
  <SolidColorBrush x:Key="Nvt.Toggle.TransparentBrush" Color="#00FFFFFF" />
  <Thickness x:Key="Nvt.Toggle.SegmentGroupPadding">4</Thickness>
  <x:Double x:Key="Nvt.Toggle.SegmentSpacing">2</x:Double>
  <x:Double x:Key="Nvt.Toggle.Height">40</x:Double>
  <Thickness x:Key="Nvt.Toggle.Padding">20,0</Thickness>
  <x:Double x:Key="Nvt.Toggle.IconSize">40</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchWidth">58</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchTrackWidth">52</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchTrackHeight">28</x:Double>
  <Thickness x:Key="Nvt.Toggle.SwitchTrackBorderThickness">2</Thickness>
  <x:Double x:Key="Nvt.Toggle.SwitchKnobTravel">24</x:Double>
  <Thickness x:Key="Nvt.Toggle.SwitchKnobMargin">6,0,0,0</Thickness>
  <x:Double x:Key="Nvt.Toggle.SwitchKnobSize">22</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchKnobTopOffset">3</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchFocusWidth">60</x:Double>
  <x:Double x:Key="Nvt.Toggle.SwitchFocusHeight">36</x:Double>
  <transforms:TransformOperations x:Key="Nvt.Toggle.PressedTransform">scale(0.98)</transforms:TransformOperations>
  <Thickness x:Key="Nvt.Toggle.SoftPadding">12,0</Thickness>
</ResourceDictionary>
