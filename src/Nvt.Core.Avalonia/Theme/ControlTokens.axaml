<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:Nvt.Core.Avalonia.Theme">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Nvt.Controls.SelectedBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.18" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedPointerOverBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.12" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedRestBrush" theme:AccentBrush.Transparent="True" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.12" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedPressedBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.15" />
      <!-- The rest fill of a control that gains a hover fill. It has the hover colour at zero alpha, so a BrushTransition fades only alpha and never passes through white. -->
      <StaticResource x:Key="Nvt.Console.LinkUnderlineBrush" ResourceKey="NfcBorderBrush" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedForegroundBrush" theme:AccentBrush.From="{DynamicResource NfcAccentStrongBrush}" theme:AccentBrush.To="{DynamicResource NfcTextStrongBrush}" theme:AccentBrush.Amount="0.22" />
      <SolidColorBrush x:Key="Nvt.Controls.FocusBrush" Color="#1557C0" />
      <StaticResource x:Key="Nvt.Controls.ChoiceForegroundBrush" ResourceKey="NfcTextStrongBrush" />
      <StaticResource x:Key="Nvt.Controls.ExpanderPressedBrush" ResourceKey="Nvt.Interaction.PressedFillBrush" />
      <SolidColorBrush x:Key="Nvt.Controls.ExpanderPressedForegroundBrush" Color="#0B1220" />
      <SolidColorBrush x:Key="Nvt.Controls.ExpanderDisabledForegroundBrush" Color="#637085" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Nvt.Controls.SelectedBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.22" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedPointerOverBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.19" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedRestBrush" theme:AccentBrush.Transparent="True" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.19" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedPressedBrush" theme:AccentBrush.From="{DynamicResource NfcSurfaceBrush}" theme:AccentBrush.To="{DynamicResource NfcAccentBrush}" theme:AccentBrush.Amount="0.25" />
      <StaticResource x:Key="Nvt.Console.LinkUnderlineBrush" ResourceKey="NfcBorderBrush" />
      <SolidColorBrush x:Key="Nvt.Controls.SelectedForegroundBrush" theme:AccentBrush.From="{DynamicResource NfcAccentStrongBrush}" theme:AccentBrush.To="{DynamicResource NfcTextStrongBrush}" theme:AccentBrush.Amount="0.45" />
      <SolidColorBrush x:Key="Nvt.Controls.FocusBrush" Color="#8FC5FF" />
      <SolidColorBrush x:Key="Nvt.Controls.ChoiceForegroundBrush" Color="#FFFFFF" />
      <StaticResource x:Key="Nvt.Controls.ExpanderPressedBrush" ResourceKey="Nvt.Interaction.PressedFillBrush" />
      <SolidColorBrush x:Key="Nvt.Controls.ExpanderPressedForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Nvt.Controls.ExpanderDisabledForegroundBrush" Color="#91A1B9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <!-- Soft keeps today's rest fills. RestFillNone.axaml sets this to None, which makes choice rows and Expander headers transparent at rest. -->
  <x:String x:Key="Nvt.Controls.RestFillMode">Soft</x:String>
  <Thickness x:Key="Nvt.Controls.FocusRingMargin">-4</Thickness>
  <Thickness x:Key="Nvt.Controls.InsetFocusRingMargin">2</Thickness>
</ResourceDictionary>
