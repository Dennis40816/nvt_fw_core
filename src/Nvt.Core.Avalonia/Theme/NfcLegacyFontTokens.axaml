<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size10">10</x:Double>
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size11">11</x:Double>
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size12">12</x:Double>
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size13">13</x:Double>
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size14">14</x:Double>
  <x:Double x:Key="Nvt.Font.NfcLegacy.Size16">16</x:Double>
  <FontFamily x:Key="Nvt.Font.NfcLegacy.Ui.Family">fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI</FontFamily>
  <FontFamily x:Key="Nvt.Font.NfcLegacy.Technical.Family">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
