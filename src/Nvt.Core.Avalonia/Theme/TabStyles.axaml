<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TabControl">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.TransparentBrush}" />
    <Setter Property="Padding" Value="{DynamicResource Nvt.Tab.ContentPadding}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nvt.Tab.EmptyThickness}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="TabStrip" DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                  Background="{DynamicResource Nvt.Tab.StripBrush}" Padding="{DynamicResource Nvt.Tab.StripPadding}"
                  CornerRadius="{DynamicResource Nvt.Shape.GroupCornerRadius}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <Panel ClipToBounds="True">
            <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="{DynamicResource Nvt.Tab.EmptyThickness}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Theme" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nvt.Tab.Height}" />
    <Setter Property="Height" Value="{DynamicResource Nvt.Tab.Height}" />
    <Setter Property="Padding" Value="{DynamicResource Nvt.Tab.Padding}" />
    <Setter Property="Margin" Value="{DynamicResource Nvt.Tab.ItemMargin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.ControlCornerRadius}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nvt.Tab.EmptyThickness}" />
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="UseLayoutRounding" Value="False" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource Nvt.Tab.StateTransitionDuration}" />
        <BrushTransition Property="Foreground" Duration="{StaticResource Nvt.Tab.StateTransitionDuration}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{DynamicResource Nvt.Tab.TransparentBrush}">
          <Border Name="TabBody" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <Border Name="TabIndicator" IsVisible="False" IsHitTestVisible="False"
                  Height="{DynamicResource Nvt.Tab.IndicatorThickness}" VerticalAlignment="Bottom" Margin="{DynamicResource Nvt.Tab.IndicatorMargin}"
                  Background="{DynamicResource Nvt.Tab.IndicatorBrush}" CornerRadius="{DynamicResource Nvt.Shape.RoundCornerRadius}" />
          <Border Name="TabFocusRing" IsVisible="False" IsHitTestVisible="False" Margin="{DynamicResource Nvt.Controls.FocusRingMargin}"
                  BorderBrush="{DynamicResource Nvt.Tab.FocusBrush}" BorderThickness="{DynamicResource Nvt.Focus.RingThickness}"
                  CornerRadius="{DynamicResource Nvt.Shape.FocusCornerRadius}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.HoverFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.HoverTextBrush}" />
  </Style>
  <Style Selector="TabItem:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.PressedFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.PressedTextBrush}" />
  </Style>
  <Style Selector="TabItem:selected:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.SelectedFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.SelectedTextBrush}" />
  </Style>
  <Style Selector="TabItem:selected:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.SelectedHoverFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.SelectedTextBrush}" />
  </Style>
  <Style Selector="TabItem:selected:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.SelectedPressedFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.SelectedTextBrush}" />
  </Style>
  <Style Selector="TabItem:disabled">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.DisabledFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.DisabledTextBrush}" />
  </Style>
  <Style Selector="TabItem:selected:disabled">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.DisabledSelectedFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Tab.DisabledTextBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#TabIndicator">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TabItem:selected:disabled /template/ Border#TabIndicator">
    <Setter Property="Background" Value="{DynamicResource Nvt.Tab.DisabledTextBrush}" />
  </Style>
  <Style Selector="TabItem:focus-visible:not(:disabled) /template/ Border#TabFocusRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TabItem.reducedMotion, .reducedMotion TabItem">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="TabItem[TabStripPlacement=Bottom] /template/ Border#TabIndicator">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{DynamicResource Nvt.Tab.BottomIndicatorMargin}" />
  </Style>
  <Style Selector="TabItem[TabStripPlacement=Left] /template/ Border#TabIndicator, TabItem[TabStripPlacement=Right] /template/ Border#TabIndicator">
    <Setter Property="Width" Value="{DynamicResource Nvt.Tab.IndicatorThickness}" />
    <Setter Property="Height" Value="{DynamicResource Nvt.Tab.IndicatorLength}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TabItem[TabStripPlacement=Left] /template/ Border#TabIndicator">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="{DynamicResource Nvt.Tab.LeftIndicatorMargin}" />
  </Style>
  <Style Selector="TabItem[TabStripPlacement=Right] /template/ Border#TabIndicator">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="{DynamicResource Nvt.Tab.RightIndicatorMargin}" />
  </Style>
</Styles>
