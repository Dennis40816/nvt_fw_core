<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.toggleSegmentGroup">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.GroupCornerRadius}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="UseLayoutRounding" Value="False"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="Border.toggleSegmentGroup > StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="2"/>
    <Setter Property="UseLayoutRounding" Value="False"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment, ToggleButton.toggleTab, ToggleButton.toggleIcon, ToggleButton.toggleSwitch, ToggleSwitch">
    <Setter Property="Theme" Value="{x:Null}"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.ControlCornerRadius}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Nvt.Toggle.TransparentBrush}"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="UseLayoutRounding" Value="False"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment, ToggleButton.toggleTab, ToggleButton.toggleIcon, ToggleButton.toggleSwitch, ToggleSwitch">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.toggleSegment, ToggleButton.toggleTab, ToggleButton.toggleIcon">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{DynamicResource Nvt.Toggle.TransparentBrush}">
          <Border x:Name="ToggleBody" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </Border>
          <Border x:Name="ToggleFocusRing" Margin="-4" IsVisible="False" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Nvt.Focus.RingBrush}" BorderThickness="{DynamicResource Nvt.Focus.RingThickness}"
                  CornerRadius="{DynamicResource Nvt.Shape.FocusCornerRadius}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.toggleIcon">
    <Setter Property="Width" Value="40"/>
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.ControlCornerRadius}"/>
  </Style>
  <!-- Plain sibling labels and a separate navigation baseline distinguish tabs from grouped choices. -->
  <Style Selector="ToggleButton.toggleTab">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.TransparentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.TransparentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:pointerover:not(:disabled), ToggleButton.toggleTab:pointerover:not(:disabled), ToggleButton.toggleIcon:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:pressed:not(:disabled), ToggleButton.toggleTab:pressed:not(:disabled), ToggleButton.toggleIcon:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:checked:not(:disabled), ToggleButton.toggleTab:checked:not(:disabled), ToggleButton.toggleIcon:checked:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SelectedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Toggle.SelectedLabelBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:checked:pointerover:not(:disabled), ToggleButton.toggleTab:checked:pointerover:not(:disabled), ToggleButton.toggleIcon:checked:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SelectedPointerOverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Toggle.SelectedLabelBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:checked:pressed:not(:disabled), ToggleButton.toggleTab:checked:pressed:not(:disabled), ToggleButton.toggleIcon:checked:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SelectedPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Toggle.SelectedLabelBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:disabled, ToggleButton.toggleTab:disabled, ToggleButton.toggleIcon:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:disabled:checked, ToggleButton.toggleTab:disabled:checked, ToggleButton.toggleIcon:disabled:checked">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch, ToggleSwitch">
    <Setter Property="Width" Value="58"/>
    <Setter Property="MinWidth" Value="58"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.RoundCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch, ToggleSwitch">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{DynamicResource Nvt.Toggle.TransparentBrush}">
          <Border x:Name="ToggleBody" Width="52" Height="28" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="{DynamicResource Nvt.Shape.RoundCornerRadius}"/>
          <Canvas x:Name="PART_SwitchKnob" Width="24" Height="28" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid x:Name="PART_MovingKnobs" Width="22" Height="22" Canvas.Left="0" Canvas.Top="3">
              <Grid.Transitions><Transitions><DoubleTransition Property="Canvas.Left" Duration="0:0:0.15" Easing="CubicEaseOut"/></Transitions></Grid.Transitions>
              <Ellipse x:Name="ToggleKnob" Fill="{DynamicResource Nvt.Toggle.KnobBrush}"/>
            </Grid>
          </Canvas>
          <Border x:Name="ToggleFocusRing" Width="60" Height="36" Margin="-4" IsVisible="False" IsHitTestVisible="False" CornerRadius="{DynamicResource Nvt.Shape.RoundCornerRadius}"
                  BorderBrush="{DynamicResource Nvt.Focus.RingBrush}" BorderThickness="{DynamicResource Nvt.Focus.RingThickness}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="KnobTransitions">
      <Transitions><DoubleTransition Property="Canvas.Left" Duration="0:0:0.15" Easing="CubicEaseOut"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:pointerover:not(:disabled), ToggleSwitch:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:pressed:not(:disabled), ToggleSwitch:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:checked:not(:disabled), ToggleSwitch:checked:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SwitchOnBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:checked:pointerover:not(:disabled), ToggleSwitch:checked:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SwitchPointerOverBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:checked:pressed:not(:disabled), ToggleSwitch:checked:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.SwitchPressedBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:disabled, ToggleSwitch:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:disabled:checked, ToggleSwitch:disabled:checked">
    <Setter Property="Background" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSwitch:checked /template/ Grid#PART_MovingKnobs">
    <Setter Property="Canvas.Left" Value="24"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:focus-visible:not(:disabled) /template/ Border#ToggleFocusRing, ToggleButton.toggleTab:focus-visible:not(:disabled) /template/ Border#ToggleFocusRing, ToggleButton.toggleIcon:focus-visible:not(:disabled) /template/ Border#ToggleFocusRing, ToggleButton.toggleSwitch:focus-visible:not(:disabled) /template/ Border#ToggleFocusRing, ToggleSwitch:focus-visible:not(:disabled) /template/ Border#ToggleFocusRing">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment.danger:checked:not(:disabled), ToggleButton.toggleTab.danger:checked:not(:disabled), ToggleButton.toggleIcon.danger:checked:not(:disabled), ToggleButton.toggleSwitch.danger:checked:not(:disabled), ToggleSwitch.danger:checked:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.DangerFillBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource Nvt.Toggle.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment.danger:checked:pointerover:not(:disabled), ToggleButton.toggleTab.danger:checked:pointerover:not(:disabled), ToggleButton.toggleIcon.danger:checked:pointerover:not(:disabled), ToggleButton.toggleSwitch.danger:checked:pointerover:not(:disabled), ToggleSwitch.danger:checked:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.DangerFillPointerOverBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment.danger:checked:pressed:not(:disabled), ToggleButton.toggleTab.danger:checked:pressed:not(:disabled), ToggleButton.toggleIcon.danger:checked:pressed:not(:disabled), ToggleButton.toggleSwitch.danger:checked:pressed:not(:disabled), ToggleSwitch.danger:checked:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Nvt.Toggle.DangerFillPressedBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toggleSegment:focus-visible">
    <Setter Property="ZIndex" Value="2"/>
  </Style>
  <!-- Preserve the approved pressed inset without changing layout or hit targets. -->
  <Style Selector="ToggleButton.toggleSegment:pressed:not(:disabled), ToggleButton.toggleTab:pressed:not(:disabled), ToggleButton.toggleIcon:pressed:not(:disabled), ToggleButton.toggleSwitch:pressed:not(:disabled)">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
</Styles>
