<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nvt.Core.Avalonia.Inputs.NumberScrubber">
  <Border x:Name="RootBorder" Classes="numberScrubber">
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="InputBox"
               Classes="numberScrubberInput"
               Grid.Column="0"
               BorderThickness="0"
               Background="Transparent"
               HorizontalContentAlignment="Left"
               VerticalContentAlignment="Center"/>
      <Border x:Name="ScrubArea"
              Grid.Column="1"
              Classes="numberScrubberSpin"/>
    </Grid>
  </Border>
</UserControl>
