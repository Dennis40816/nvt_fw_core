<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives">
  <Style Selector="primitives|SectionFrame">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:SectionFrame">
          <StackPanel Spacing="{DynamicResource NfcSpace8}">
            <Grid ColumnDefinitions="*,Auto,*"
                  ColumnSpacing="{DynamicResource NfcSpace8}">
              <Border Classes="sectionDividerLine"/>
              <SelectableTextBlock Grid.Column="1"
                                   Classes="sectionDividerText"
                                   Text="{TemplateBinding Title}"/>
              <Border Grid.Column="2"
                      Classes="sectionDividerLine"/>
            </Grid>

            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="primitives|SectionFrame /template/ Border.sectionDividerLine">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="primitives|SectionFrame /template/ SelectableTextBlock.sectionDividerText">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector="primitives|InfoLabel">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="primitives|InfoLabel SelectableTextBlock.infoLabelText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
</Styles>
