<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nvt.Core.Avalonia.Primitives.InfoLabel"
             x:Name="Root"
             ToolTip.Tip="{Binding Tip, ElementName=Root}">
  <SelectableTextBlock Classes="infoLabelText"
                       Text="{Binding Text, ElementName=Root}"
                       TextWrapping="Wrap"/>
</UserControl>
