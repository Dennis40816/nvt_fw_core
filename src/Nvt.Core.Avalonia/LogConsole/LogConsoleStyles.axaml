<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lc="using:Nvt.Core.Avalonia.LogConsole">
  <Styles.Resources><lc:ConsoleValueConverter x:Key="ConsoleSearchEmpty"/><lc:ConsoleLayoutConverter x:Key="ConsoleLayout"/></Styles.Resources>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ButtonStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ToggleStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/MenuStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Icons/IconStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Focus/ToolTipStyles.axaml"/>
  <Style Selector="lc|ConsoleHeader, lc|ConsoleToolbar, lc|ConsoleEmptyState">
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.Body.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.Body.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.Body.Weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>
  <Style Selector="Button.consoleAction, MenuItem.consoleMenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.Body.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.Body.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.Body.Weight}"/>
  </Style>
  <!-- Popup labels are logical Button descendants, but have no visual Button ancestor. -->
  <Style Selector="MenuItem.consoleMenuItem TextBlock, MenuItem.consoleMenuItem AccessText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>
  <Style Selector="MenuItem.consoleMenuItem:disabled TextBlock, MenuItem.consoleMenuItem:disabled AccessText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>
  <Style Selector="MenuItem.consoleMenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.consoleHeading">
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.Heading.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.Heading.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.Heading.Weight}"/>
  </Style>
  <Style Selector="ToggleButton.consoleLevel">
    <Setter Property="Width" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="LevelFeedback" Background="{DynamicResource NfcSelectionSurfaceBrush}" Opacity="0"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="LevelFocus" Margin="{Binding Source={StaticResource NfcSpace4}, Converter={StaticResource ConsoleLayout}, ConverterParameter=Focus}" IsVisible="False" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Nvt.Focus.RingBrush}" BorderThickness="{DynamicResource Nvt.Focus.RingThickness}"
                  CornerRadius="{DynamicResource Nvt.Shape.FocusCornerRadius}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.consoleLevel:checked, ToggleButton.consoleLevel:pointerover, ToggleButton.consoleLevel:pressed">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.consoleLevel TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/></Style>
  <Style Selector="ToggleButton.consoleTrace:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/></Style>
  <Style Selector="ToggleButton.consoleDebug:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/></Style>
  <Style Selector="ToggleButton.consoleInfo:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcInfoTextBrush}"/></Style>
  <Style Selector="ToggleButton.consoleWarn:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/></Style>
  <Style Selector="ToggleButton.consoleError:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}"/></Style>
  <Style Selector="ToggleButton.consoleFatal:checked TextBlock.nvtIcon"><Setter Property="Foreground" Value="{DynamicResource NfcDangerTextStrongBrush}"/></Style>
  <Style Selector="ToggleButton.consoleLevel:pointerover /template/ Border#LevelFeedback"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="ToggleButton.consoleLevel:pressed /template/ Border#LevelFeedback">
    <Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
  </Style>
  <Style Selector="ToggleButton.consoleLevel:focus-visible /template/ Border#LevelFocus"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="ToggleButton.toggleSoft.consoleToggle:checked"><Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.BodyStrong.Weight}"/></Style>
  <Style Selector="ToggleButton.toggleSoft.consoleToggle /template/ ContentPresenter">
    <Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style Selector="ToggleButton.toggleSoft.consoleToggle TextBlock.consoleToggleLabel">
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.Body.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.Body.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.Body.Weight}"/>
    <Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style Selector="ToggleButton.toggleSoft.consoleToggle:checked TextBlock.consoleToggleLabel">
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.BodyStrong.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.BodyStrong.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.BodyStrong.Weight}"/>
  </Style>
  <Style Selector="TextBox.consoleSearch">
    <Setter Property="Theme" Value="{x:Null}"/>
    <Setter Property="Height" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding"><MultiBinding Converter="{StaticResource ConsoleLayout}" ConverterParameter="Search"><Binding Source="{StaticResource NfcSpace12}"/><Binding Source="{StaticResource NfcSpace4}"/><Binding Source="{StaticResource NfcControlHeight}"/></MultiBinding></Setter>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource Nvt.Focus.RingThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.ControlCornerRadius}"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Nvt.Font.Body.Family}"/>
    <Setter Property="FontSize" Value="{DynamicResource Nvt.Font.Body.Size}"/>
    <Setter Property="FontWeight" Value="{DynamicResource Nvt.Font.Body.Weight}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Panel Margin="{TemplateBinding Padding}">
              <TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource NfcTextMutedBrush}"
                         VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ConsoleSearchEmpty}, ConverterParameter=EmptyText}"/>
              <ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.Template>
                  <ControlTemplate><ScrollContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/></ControlTemplate>
                </ScrollViewer.Template>
                <TextPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text}" TextWrapping="{TemplateBinding TextWrapping}"
                               TextAlignment="{TemplateBinding TextAlignment}" VerticalAlignment="Center"
                               CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}"
                               CaretBrush="{TemplateBinding CaretBrush}" SelectionBrush="{TemplateBinding SelectionBrush}"
                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"/>
              </ScrollViewer>
            </Panel>
          </Border>
          <Border x:Name="SearchFocus" Margin="{Binding Source={StaticResource NfcSpace4}, Converter={StaticResource ConsoleLayout}, ConverterParameter=Focus}" IsVisible="False" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Nvt.Focus.RingBrush}" BorderThickness="{DynamicResource Nvt.Focus.RingThickness}"
                  CornerRadius="{DynamicResource Nvt.Shape.FocusCornerRadius}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBox.consoleSearch:focus-visible /template/ Border#SearchFocus"><Setter Property="IsVisible" Value="True"/></Style>
</Styles>
