<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Nvt.Core.Avalonia/Theme/ThemeTokens.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <TextBlock x:Key="StaticUi" FontFamily="{StaticResource NfcUiFontFamily}"
             FontSize="{StaticResource NfcFontSize14}" FontWeight="SemiBold" TextWrapping="Wrap" />
  <TextBlock x:Key="DynamicUi" FontFamily="{DynamicResource NfcUiFontFamily}"
             FontSize="{DynamicResource NfcFontSize14}" FontWeight="SemiBold" TextWrapping="Wrap" />
  <TextBlock x:Key="StaticTechnical" FontFamily="{StaticResource NfcTechnicalFontFamily}"
             FontSize="{StaticResource NfcFontSize13}" TextWrapping="Wrap" />
  <TextBlock x:Key="DynamicTechnical" FontFamily="{DynamicResource NfcTechnicalFontFamily}"
             FontSize="{DynamicResource NfcFontSize13}" TextWrapping="Wrap" />
</ResourceDictionary>
