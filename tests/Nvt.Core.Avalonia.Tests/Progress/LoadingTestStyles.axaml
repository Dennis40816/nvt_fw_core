<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:progress="using:Nvt.Core.Avalonia.Progress"
        xmlns:tests="using:Nvt.Core.Avalonia.Tests.Progress">
  <Styles.Resources>
    <!-- Both structures use the same synthetic themes, with no animation clock. -->
    <ControlTheme x:Key="{x:Type ContentControl}" TargetType="ContentControl">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="PART_Track" Background="{TemplateBinding Background}">
            <Border Name="PART_Indicator"
                    Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="ForegroundLoadingStatusTemplate" DataType="tests:LoadingTestState">
      <Border Name="FixtureCard"
              Padding="{Binding $parent[ContentControl].Padding}"
              Background="{DynamicResource NfcSurfaceBrush}"
              BorderBrush="{DynamicResource NfcBorderSoftBrush}"
              BorderThickness="2"
              CornerRadius="{DynamicResource NfcSurfaceCornerRadius}">
        <StackPanel Spacing="{DynamicResource NfcSpace12}">
          <TextBlock Text="{Binding AccessibleStatus}"
                     Foreground="{DynamicResource NfcTextStrongBrush}"
                     FontSize="18"
                     TextWrapping="Wrap" />
          <ProgressBar Name="FixtureProgress"
                       Height="5"
                       Maximum="1"
                       Foreground="{DynamicResource NfcAccentBrush}"
                       IsIndeterminate="{Binding ShouldAnimate}"
                       IsVisible="{Binding IsRunning}"
                       Value="{Binding Fraction}" />
          <Border Background="{DynamicResource NfcAccentBrush}"
                  Width="72" Height="24"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding CanRetry}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CoreLoadingStatusTemplate" DataType="tests:LoadingTestState">
      <Border Name="FixtureCard"
              Padding="{Binding $parent[ContentControl].Padding}"
              Background="{DynamicResource NfcSurfaceBrush}"
              BorderBrush="{DynamicResource NfcBorderSoftBrush}"
              BorderThickness="2"
              CornerRadius="{DynamicResource NfcSurfaceCornerRadius}">
        <StackPanel Spacing="{DynamicResource NfcSpace12}">
          <TextBlock Text="{Binding AccessibleStatus}"
                     Foreground="{DynamicResource NfcTextStrongBrush}"
                     FontSize="18"
                     TextWrapping="Wrap" />
          <progress:ProgressIndicator Name="FixtureProgress"
                                      Height="5"
                                      Maximum="1"
                                      Foreground="{DynamicResource NfcAccentBrush}"
                                      IsIndeterminate="{Binding ShouldAnimate}"
                                      IsVisible="{Binding IsRunning}"
                                      Progress="{Binding Update}" />
          <Border Background="{DynamicResource NfcAccentBrush}"
                  Width="72" Height="24"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding CanRetry}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="progress|LoadingSurface /template/ ContentControl#PART_Content">
    <Setter Property="Width" Value="430" />
    <Setter Property="Padding" Value="28,26" />
  </Style>
</Styles>