<!-- Frozen "Before" record of Tool A at source commit 6b3390e. It covers only the toggle roles in the comparison. Disclosure, expander and choice-list roles are not included. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ToolA.Value00" Color="#BFDBFE" />
          <SolidColorBrush x:Key="ToolA.Value01" Color="#60A5FA" />
